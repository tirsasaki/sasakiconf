# ~/.config/ghostty/config
# Konfigurasi Ghostty LENGKAP - Tema One Dark, background transparan, font size 10
# Cocok untuk KDE Plasma di CachyOS

# =========================
# TEMA & WARNA - ONE DARK
# =========================
background = #282c34
foreground = #abb2bf
cursor-color = #528bff
selection-background = #3e4451
selection-foreground = #abb2bf

palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf
palette = 8=#5c6370
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#ffffff

# =========================
# TRANSPARANSI & BLUR
# =========================
background-opacity = 0.85
background-blur-radius = 20
unfocused-split-opacity = 0.7

# =========================
# FONT
# =========================
font-size = 10
font-family = "JetBrains Mono"
font-family-bold = "JetBrains Mono Bold"
font-family-italic = "JetBrains Mono Italic"
font-thicken = false
adjust-cell-height = 0%

# =========================
# WINDOW / TAMPILAN
# =========================
window-padding-x = 10
window-padding-y = 10
window-decoration = true
window-theme = dark
window-save-state = always
confirm-close-surface = false

# =========================
# CURSOR
# =========================
cursor-style = block
cursor-style-blink = true

# =========================
# SCROLLBACK & MOUSE
# =========================
scrollback-limit = 10000
mouse-hide-while-typing = true
copy-on-select = true

# =========================
# SHELL
# =========================
# command = /bin/bash
shell-integration = detect
shell-integration-features = cursor,sudo,title

# =========================
# TAB & SPLIT
# =========================
window-new-tab-position = end

# =========================
# KEYBINDINGS TAMBAHAN
# =========================
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down

# =========================
# LAIN-LAIN
# =========================
gtk-single-instance = true
quit-after-last-window-closed = true
